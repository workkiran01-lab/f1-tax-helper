# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Groq (server-side only — never prefix with VITE_)
GROQ_API_KEY=gsk_...

# Optional: global daily ceiling on AI chat requests (default 3000)
CHAT_DAILY_CAP=3000

# Resend (server-side only)
RESEND_API_KEY=re_...

# Optional
VITE_SENTRY_DSN=https://...

# Optional exact additional origins (comma-separated; no wildcards). Vercel's
# VERCEL_URL and VERCEL_BRANCH_URL are allowed automatically for previews.
ALLOWED_ORIGINS=
# Optional. Leave unset to use the default (openai/gpt-oss-120b). Groq retires
# model IDs; check https://console.groq.com/docs/deprecations before setting one.
GROQ_MODEL=
# Optional. Comma-separated models tried when the first is over its Groq limit or down.
# Leave unset for openai/gpt-oss-20b; set to none to turn the fallback off.
GROQ_FALLBACK_MODELS=
