# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Groq (server-side only — never prefix with VITE_)
GROQ_API_KEY=gsk_...

# Upstash Redis (server-side only)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# Resend (server-side only)
RESEND_API_KEY=re_...

# Optional
VITE_SENTRY_DSN=https://...

# Optional exact additional origins (comma-separated; no wildcards). Vercel's
# VERCEL_URL and VERCEL_BRANCH_URL are allowed automatically for previews.
ALLOWED_ORIGINS=
GROQ_MODEL=llama-3.3-70b-versatile
